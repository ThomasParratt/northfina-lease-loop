{
  "openapi": "3.1.0",
  "info": {
    "title": "lease-loop",
    "version": "0.1.0",
    "description": "Lease Loop hackathon starter: a walking skeleton for a circular-economy leasing app."
  },
  "tags": [
    {
      "name": "assets"
    },
    {
      "name": "audit"
    }
  ],
  "paths": {
    "/api/assets": {
      "get": {
        "summary": "List the assets in the catalogue, optionally of one category",
        "tags": ["assets"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["e_bike", "laptop", "farm_machine"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "category": {
                            "type": "string",
                            "enum": ["e_bike", "laptop", "farm_machine"]
                          },
                          "make": {
                            "type": "string",
                            "minLength": 1
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1
                          },
                          "model_year": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "serial_number": {
                            "type": "string",
                            "minLength": 1
                          },
                          "condition": {
                            "type": "string",
                            "enum": ["new", "like_new", "good", "fair", "poor"]
                          },
                          "usage": {
                            "type": "object",
                            "properties": {
                              "unit": {
                                "type": "string",
                                "enum": ["km", "battery_cycles", "engine_hours"]
                              },
                              "value": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": ["unit", "value"],
                            "additionalProperties": false
                          },
                          "previous_lives": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "status": {
                            "type": "string",
                            "enum": ["available", "reserved", "returned"]
                          }
                        },
                        "required": [
                          "id",
                          "category",
                          "make",
                          "model",
                          "model_year",
                          "serial_number",
                          "condition",
                          "usage",
                          "previous_lives",
                          "status"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "timestamp": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": ["timestamp"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "data", "meta"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "An error: 400 VALIDATION_ERROR or INVALID_JSON, 404, 409, 500 INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "timestamp": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": ["timestamp"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "error", "meta"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/assets/{id}/status": {
